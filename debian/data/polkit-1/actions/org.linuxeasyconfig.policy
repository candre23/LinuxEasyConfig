<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux Easy Config Project</vendor>
  <vendor_url>https://github.com/REPLACE-WITH-YOUR-ACCOUNT/linuxeasyconfig</vendor_url>

  <action id="org.linuxeasyconfig.privileged-helper">
    <description>Perform an administrative Linux Easy Config task</description>
    <message>Authentication is required to change system configuration with Linux Easy Config</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/linuxeasyconfig/lec-privileged-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
