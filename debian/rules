#!/usr/bin/make -f

export PYBUILD_NAME=linuxeasyconfig
export PYTHONDONTWRITEBYTECODE=1

%:
	dh $@ --buildsystem=pybuild

override_dh_auto_build:
	set -e; \
	python3 -B tools/build_builtin_modules.py; \
	trap 'python3 -B tools/build_builtin_modules.py --clean' EXIT; \
	dh_auto_build --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install --buildsystem=pybuild
	set -e; \
	package_root="debian/linuxeasyconfig"; \
	target="$$package_root/usr/lib/python3/dist-packages"; \
	mkdir -p "$$target"; \
	for source in "$$package_root"/usr/lib/python3.*/dist-packages; do \
		if [ -d "$$source" ]; then \
			cp -a "$$source"/. "$$target"/; \
			rm -rf "$${source%/dist-packages}"; \
		fi; \
	done

override_dh_auto_clean:
	python3 -B tools/build_builtin_modules.py --clean || true
	dh_auto_clean --buildsystem=pybuild
